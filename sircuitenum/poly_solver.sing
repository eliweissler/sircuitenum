// Library: Poly Solver via Groebner Cover
// Loads required libs and defines a reusable proc to compute branches.

LIB "grobcov.lib";
LIB "primdec.lib";

// solve_cover(fixed_params_csv, potential_vars_csv, eqs_csv)
// - fixed_params_csv: comma-separated parameter names (no spaces), e.g. "a,b"
// - potential_vars_csv: comma-separated variable names (no spaces), e.g. "x,y"
// - eqs_csv: comma-separated polynomial equations, e.g. "a*x-b, x^2+y-a"
// Returns a single string with markers suitable for parsing in Python.
proc solve_cover(string fixed_params, string pot_vars, string eqs_csv)
{
    // system("sh", " echo '----------------------------------------------------------'>> /tmp/sing_debug.log");
    // system("sh", " echo '----------------------------------------------------------'>> /tmp/sing_debug.log");
    // system("sh", " echo 'STARTING solve_cover'>> /tmp/sing_debug.log");
    // string out = "";

    list out_list;
    int out_idx = 0;
    out_idx++; out_list[out_idx] = "|||START|||";

    // Build base ring r (parameters in coefficient field, variables as ring vars)
    int n_fixed = countCleanChars(fixed_params);
    int n_pot = countCleanChars(pot_vars);
    string ring_cmd;
    if (size(fixed_params) > 0)
    {
        ring_cmd = "ring r_base = 0, (" + pot_vars + "," + fixed_params + "), (dp(" + string(n_pot) + "),"+"dp(" + string(n_fixed) + "));";
    }
    else
    {
        ring_cmd = "ring r_base = 0, (" + pot_vars + "), dp;";
    }
    // system("sh", " echo 'ring cmd " + ring_cmd + "'>> /tmp/sing_debug.log");

    
    execute(ring_cmd);

    // system("sh", " echo 'nvars_total " + string(nvars_total) + "'>> /tmp/sing_debug.log");
    // system("sh", " echo 'n_fixed " + string(n_fixed) + "'>> /tmp/sing_debug.log");
    // system("sh", " echo 'n_pot " + string(n_pot) + "'>> /tmp/sing_debug.log");

    // Define ideal from CSV (assumes eqs_csv uses '^' for powers)
    execute("ideal i_base = " + eqs_csv + ";");
    // system("sh", " echo 'generated ideal " + string(i) + "'>> /tmp/sing_debug.log");
    // system("sh", " echo 'generated ideal degree " + string(deg(i)) + "'>> /tmp/sing_debug.log");
    // system("sh", " echo 'fixed params " + fixed_params + "'>> /tmp/sing_debug.log");
    // system("sh", " echo 'pot vars " + pot_vars + "'>> /tmp/sing_debug.log");


    // Step 1: Factor the ideal
    // For each factorization component, run minAssGTZ to get prime components
    list fac_basis = facstd(i_base);
    // system("sh", " echo 'factored ideal into " + string(size(fac_basis)) + " components'>> /tmp/sing_debug.log");
    int idx_p, idx_k, idx_j, idx_m, idx_q;
    int branch_id = 0;
    for (idx_q=1; idx_q <= size(fac_basis); idx_q++)
    {
        // system("sh", " echo '-----------------------------------'>> /tmp/sing_debug.log");
        // system("sh", " echo 'factor basis " + string(q) + " : " + string(fac_basis[q]) + "'>> /tmp/sing_debug.log");
        list prime_comps = minAssGTZ(fac_basis[idx_q]);
        // Step 2: For each prime component, find maximal independent sets and run grobcov
        for (idx_p=1; idx_p<=size(prime_comps); idx_p++)
        {
            ideal comp = prime_comps[idx_p];
            comp = std(comp);
            // system("sh", " echo '---------------------------'>> /tmp/sing_debug.log");
            // system("sh", " echo 'prime component number " + string(p) + "'>> /tmp/sing_debug.log");
            // system("sh", " echo 'prime component " + string(comp) + "'>> /tmp/sing_debug.log");
            // Find maximal independent set that respects fixed parameters
            intvec indep;
            int max_score = -1;
            if (n_fixed == 0){
                // No fixed params: take the first indep set
                indep = indepSet(comp);
            }
            else{
                // Need to find an indep set that maximized number of fixed params
                list all_MIS = indepSet(comp, 1);
                for (int idx_k=1; idx_k<=size(all_MIS); idx_k++) {
                    intvec current_mis = all_MIS[idx_k];
                    int current_score = 0;
                    // Check if desired_indices are a SUBSET of current_mis
                    int subset_check = 1;
                    for (idx_j=n_pot+1; idx_j<=n_pot+n_fixed; idx_j++) {
                        // If we want var X, but current_mis has 0 for X, fail.
                        if (current_mis[idx_j] == 0) {
                            subset_check = 0;
                        }
                        else{
                            current_score = current_score + 1;
                        }
                    }
                    if (current_score > max_score)
                    {
                        max_score = current_score;
                        indep = current_mis;
                    }
                    if (subset_check == 1) {
                        indep = current_mis;
                        break; // We found a set that includes all sure params.
                    }
                }
            }

            // system("sh", " echo 'indep set " + string(indep) + "'>> /tmp/sing_debug.log");
            // Build parameter and variable lists
            // Independent vars become additional parameters for grobcov
            // Dependent vars are what we solve for
            string param_str = "";
            string var_str = "";
            for (idx_m=1; idx_m<=nvars(basering); idx_m++)
            {
                if (indep[idx_m] == 1)
                {
                    if (size(param_str) > 0) { param_str = param_str + ","; }
                    param_str = param_str + string(var(idx_m));
                }
                else
                {
                    if (size(var_str) > 0) { var_str = var_str + ","; }
                    var_str = var_str + string(var(idx_m));
                }
            }
            // system("sh", " echo 'param_str " + param_str + "'>> /tmp/sing_debug.log");
            // system("sh", " echo 'var_str " + var_str + "'>> /tmp/sing_debug.log");
        if (param_str == "")
        {
            // No independent parameters discovered; single branch with comp basis
            branch_id = branch_id + 1;
            out_idx++; out_list[out_idx] = "|||BRANCH|||" + string(branch_id) + newline;
            out_idx++; out_list[out_idx] = "|||PARAMS|||" + param_str + newline;
            out_idx++; out_list[out_idx] = "|||VARS|||" + var_str + newline;
            out_idx++; out_list[out_idx] = "|||CONSTRAINTS|||" + newline;
            out_idx++; out_list[out_idx] = "|||NUM_CONSTRAINT_SOLUTIONS|||" + newline;
            out_idx++; out_list[out_idx] = "|||NONNULL|||" + newline;
            out_idx++; out_list[out_idx] = "|||BASIS|||" + newline;
            // Count expected number of solutions
            if (size(variables(comp)) > 0){
                execute("ring r_temp = 0, (" + string(variables(comp)) + "), lp;");
                ideal comp_temp = std(imap(r_base, comp));
                for (idx_j=1; idx_j<=size(comp_temp); idx_j++) {out_idx++; out_list[out_idx] = string(comp_temp[idx_j]) + newline; }
                out_idx++; out_list[out_idx] = "|||NUM_SOLUTIONS|||" + string(vdim(comp_temp)) + newline;
                out_idx++; out_list[out_idx] = "|||COMPONENT|||" + newline;
                ideal lpp = lead(comp_temp);
                for (idx_j=1; idx_j<=size(lpp); idx_j++){out_idx++; out_list[out_idx] = string(lpp[idx_j]) + newline;};
                setring r_base;
            }
            else{
                for (idx_j=1; idx_j<=size(comp); idx_j++) {out_idx++; out_list[out_idx] = string(comp[idx_j]) + newline;}
                out_idx++; out_list[out_idx] = "|||NUM_SOLUTIONS|||" + string(vdim(comp)) + newline;
                ideal lpp = lead(comp);
                for (idx_j=1; idx_j<=size(lpp); idx_j++){out_idx++; out_list[out_idx] = string(lpp[idx_j]) + newline;};

            }
        }
            else
            {
            // Has parameters: run grobcov
            // Combine fixed_params with discovered independent vars
            string ring_cmd_dp;
            string ring_cmd_lp;
            string ring_cmd_pr;
            ring_cmd_dp = "ring r_gc_dp = (0," + param_str + "), (" + var_str + "), dp;";
            ring_cmd_lp = "ring r_gc_lp = (0," + param_str + "), (" + var_str + "), lp;";
            if(size(var_str)>0){
                ring_cmd_pr = "ring r_gc_pr = (0," + var_str + "), (" + param_str + "), lp;";
                }
            else{
                ring_cmd_pr = "ring r_gc_pr = (0,), (" + param_str + "), lp;";
                };
            execute(ring_cmd_pr);
            execute(ring_cmd_lp);
            execute(ring_cmd_dp);
            // Use dp for speedy grobcov, lp for fglm conversions
            ideal comp_gc = imap(r_base, comp);
            def Cov = grobcov(comp_gc, "ext", 1, "rep", 1);
            for (idx_k=1; idx_k<=size(Cov); idx_k++)
            {
                // system("sh", " echo '--------------'>> /tmp/sing_debug.log");
                branch_id = branch_id + 1;
                def seg = Cov[idx_k];
                ideal basis = seg[2];
                // system("sh", " echo 'grobcov branch " + string(k) + "'>> /tmp/sing_debug.log");
                // system("sh", " echo 'basis:  " + string(basis) + "'>> /tmp/sing_debug.log");
                // Test whether we have a solution here
                if (basis[1] != 1)
                { 
                    // seg[1] = lpp, seg[2] = actual basis, seg[3] = segment info
                    // Count expected number of solutions
                    //def seginfo = seg[3];
                    ideal lpp = seg[1];
                    def constraints_info = seg[3];
                    // system("sh", " echo 'grobcov lpp " + string(seg[1]) + "'>> /tmp/sing_debug.log");
                    // TODO: INSIDE OF SEGINFO THERES INFO ABOUT IT BEING BAD -- Maybe look at Grob1Levels
                    //// system("sh", " echo 'grobcov seginfo " + string(seginfo) + "'>> /tmp/sing_debug.log");
                    // system("sh", " echo 'grobcov constraints_info " + string(constraints_info) + "'>> /tmp/sing_debug.log");
                    ideal E_null = constraints_info[1];
                    ideal N_nonnull = constraints_info[2];
                    out_idx++; out_list[out_idx] = "|||BRANCH|||" + string(branch_id) + newline;
                    out_idx++; out_list[out_idx] = "|||COMPONENT|||" + newline;
                    for (idx_j=1; idx_j<=size(lpp); idx_j++){out_idx++; out_list[out_idx] = string(lpp[idx_j]) + newline;};
                    out_idx++; out_list[out_idx] = "|||PARAMS|||" + param_str + newline;
                    out_idx++; out_list[out_idx] = "|||VARS|||" + var_str + newline;
                    out_idx++; out_list[out_idx] = "|||CONSTRAINTS|||" + newline;
                    for (idx_j=1; idx_j<=size(E_null); idx_j++)
                    {
                        if (E_null[idx_j] != 0) { out_idx++; out_list[out_idx] = string(E_null[idx_j]) + newline; }
                    }
                    // Count number of solutions to parameter constraints

                    // system("sh", " echo 'E_null " + string(E_null) + "'>> /tmp/sing_debug.log");
                    setring r_gc_pr;
                    ideal E_null_pr = imap(r_gc_dp, E_null);
                    // system("sh", " echo 'E_null_pr " + string(E_null_pr) + "'>> /tmp/sing_debug.log");
                    if (size(variables(E_null_pr)) > 0)
                    {
                        string ring_cmd_temp;
                        if(size(var_str)>0){
                            ring_cmd_temp = "ring r_temp = (0," + var_str + "), (" + string(variables(E_null_pr)) + "), lp;";
                            }
                        else{
                            ring_cmd_temp = "ring r_temp = (0,), (" + string(variables(E_null_pr)) + "), lp;";
                            };
                        execute(ring_cmd_temp);
                        ideal E_null_temp = std(imap(r_gc_pr, E_null_pr));
                        // system("sh", " echo 'E_null_temp " + string(E_null_temp) + "'>> /tmp/sing_debug.log");
                        int num_param_sols = vdim(E_null_temp);
                        out_idx++; out_list[out_idx] = "|||CONSTRAINT_BASIS|||"+newline;
                        if (num_param_sols > 0)
                        {
                            for (idx_j=1; idx_j<=size(E_null_temp); idx_j++)
                            {
                                out_idx++; out_list[out_idx] = string(E_null_temp[idx_j]) + newline;
                            }
                        }
                        out_idx++; out_list[out_idx] = "|||NUM_CONSTRAINT_SOLUTIONS|||" + string(num_param_sols) + newline;
                    }
                    else
                    {
                        out_idx++; out_list[out_idx] = "|||NUM_CONSTRAINT_SOLUTIONS|||-1" + newline;
                    }
                    setring r_gc_dp;
                    out_idx++; out_list[out_idx] = "|||NONNULL|||" + newline;
                    for (idx_j=1; idx_j<=size(N_nonnull); idx_j++)
                    {
                        if (N_nonnull[idx_j] != 0) { out_idx++; out_list[out_idx] = string(N_nonnull[idx_j]) + newline; }
                    }
                    out_idx++; out_list[out_idx] = "|||BASIS|||" + newline;
                    if (size(variables(basis)) > 0) {
                        // system("sh", " echo 'in loop basis " + string(basis) + "'>> /tmp/sing_debug.log");
                        execute("ring r_temp = (0," + param_str + "), (" + string(variables(basis)) + "), lp;");
                        ideal basis_temp = std(imap(r_gc_dp, basis));
                        int num_solutions = vdim(basis_temp);
                        // system("sh", " echo 'in loop bt " + string(basis_temp) + "'>> /tmp/sing_debug.log");
                        // system("sh", " echo 'in loop num_solutions " + string(num_solutions) + "'>> /tmp/sing_debug.log");
                        for (idx_j=1; idx_j<=size(basis_temp); idx_j++)
                        {
                            out_idx++; out_list[out_idx] = string(basis_temp[idx_j]) + newline;
                        }
                        int num_solutions = vdim(basis_temp);
                        out_idx++; out_list[out_idx] = "|||NUM_SOLUTIONS|||" + string(num_solutions) + newline;
                        setring r_gc_dp;
                    }
                    else{
                        for (idx_j=1; idx_j<=size(basis); idx_j++)
                        {
                            out_idx++; out_list[out_idx] = string(basis[idx_j]) + newline;
                        }
                        out_idx++; out_list[out_idx] = "|||NUM_SOLUTIONS|||" + string(vdim(basis)) + newline;
                    }
                    kill seg, constraints_info, E_null, N_nonnull;
                }
                else{
                    // system("sh", " echo 'no solution ----'>> /tmp/sing_debug.log");
                }
                }
                kill Cov;
            }
            setring r_base;
        }
    }
    out_idx++; out_list[out_idx] = "|||END|||";
    return(out_list);
}

// Helper procedure to count non-comma, non-whitespace characters in a string
proc countCleanChars(string st)
{
    int len = size(st);
    int count = 0;
    string charac;
    
    for (int cc_i=1; cc_i<=len; cc_i++)
    {
        charac = st[cc_i];
        // Check if charac is NOT a comma and NOT whitespace (space, tab, newline)
        if (charac != "," && charac != " " && charac != "	" && charac != "\n")
        {
            count++;
        }
    }
    return(count);
}
